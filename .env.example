# =============================================================================
# SUPPORT-AGGREGATOR ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
#   cp .env.example .env
# NEVER commit the `.env` file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# COMPONENT 1: DIAGNOSTIC TOOL (your existing product)
# -----------------------------------------------------------------------------
DIAGNOSTIC_TOOL_URL=https://your-diagnostic-tool.replit.app/mcp
DIAGNOSTIC_TOOL_ENABLED=true
DIAGNOSTIC_TOOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# COMPONENT 2: ORCHESTRATION MCP SERVERS (third-party)
# -----------------------------------------------------------------------------
# All external servers are OPTIONAL for initial testing.

# --- Prefect MCP Server (free, read-only) ---
PREFECT_MCP_URL=http://localhost:8000/mcp
PREFECT_MCP_ENABLED=true

# --- Dagster MCP Server (free, MIT, self-hosted) ---
DAGSTER_MCP_URL=http://localhost:3000/mcp
DAGSTER_MCP_ENABLED=true

# --- n8n MCP Server (free, via MCP Server Trigger node) ---
N8N_MCP_URL=https://your-n8n-instance.com/mcp
N8N_MCP_ENABLED=true

# --- Kubernetes MCP Server (free, AKS/EKS or generic) ---
K8S_MCP_URL=http://localhost:8080/mcp
K8S_MCP_ENABLED=false

# -----------------------------------------------------------------------------
# AIRFLOW (DEFERRED - documented cost tradeoff)
# -----------------------------------------------------------------------------
AIRFLOW_MCP_URL=
AIRFLOW_MCP_ENABLED=false

# -----------------------------------------------------------------------------
# AGGREGATOR SERVER CONFIGURATION
# -----------------------------------------------------------------------------
AGGREGATOR_HOST=0.0.0.0
AGGREGATOR_PORT=9000
AGGREGATOR_NAME=support-aggregator
AGGREGATOR_TRANSPORT=stdio
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CONNECTION BEHAVIOR
# -----------------------------------------------------------------------------
CONNECTION_TIMEOUT=10
TOOL_DISCOVERY_CACHE_TTL=300
ALLOW_PARTIAL_STARTUP=true
MCP_CLIENT_MODE=auto

# -----------------------------------------------------------------------------
# OPTIONAL: AUTHENTICATION
# -----------------------------------------------------------------------------
PREFECT_API_KEY=
N8N_API_KEY=
K8S_CONTEXT=

# -----------------------------------------------------------------------------
# OPTIONAL: OBSERVABILITY
# -----------------------------------------------------------------------------
LOG_FORMAT=text
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
